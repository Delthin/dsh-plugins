{
  "name": "@delthin/dsh-global-pins",
  "version": "0.2.0",
  "type": "module",
  "description": "Aggregate pinned sessions that are currently rendered and visible across workspaces into a single sidebar view, saving you from digging through separate workspaces. The aggregated section can either stay above the workspace list with independent scrolling or scroll inline with the list, directly reusing native session rows, status indicators, and actions while respecting current folding and search filters without forcibly expanding hidden items.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Delthin/dsh-plugins.git",
    "directory": "packages/global-pins"
  },
  "homepage": "https://github.com/Delthin/dsh-plugins/tree/main/packages/global-pins#readme",
  "bugs": {
    "url": "https://github.com/Delthin/dsh-plugins/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test test/*.test.js",
    "prepack": "npm run check && npm test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
