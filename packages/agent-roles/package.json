{
  "name": "@delthin/dsh-agent-roles",
  "version": "0.6.0",
  "description": "Manage reusable roles, per-role models, fallback chains, tools, and skills for native DSH Agent Teams.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.2",
    "@deepseek-ai/dsh-skill": ">=0.2.2-rc.2",
    "@deepseek-ai/schemastery": ">=3.19.0",
    "@deepseek-ai/dsh-home-paths": ">=0.2.2-rc.2",
    "@deepseek-ai/dsh-tool-executor-native": ">=0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.2"
  },
  "license": "Apache-2.0",
  "author": "Delthin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Delthin/dsh-plugins.git",
    "directory": "packages/agent-roles"
  },
  "homepage": "https://github.com/Delthin/dsh-plugins/tree/main/packages/agent-roles#readme",
  "bugs": {
    "url": "https://github.com/Delthin/dsh-plugins/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-team",
    "multi-agent",
    "roles",
    "skills"
  ],
  "engines": {
    "node": ">=22.18.0",
    "dsh": ">=0.2.2-rc.2"
  },
  "files": [
    "index.js",
    "client.js",
    "store.js",
    "skills.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "runtime.js",
    "fallback.js",
    "LICENSE-MIT-legacy"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check store.js && node --check skills.js && node --check runtime.js && node --check fallback.js && node --check scripts/check-package.mjs",
    "test": "node --test *.test.mjs",
    "prepack": "npm run check && npm test && node scripts/check-package.mjs",
    "release:check": "npm run prepack"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.2",
    "@deepseek-ai/dsh-agent-team": "0.2.2-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-agent-team": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tool-agent-team": "0.2.2-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm-retry": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tool-executor-native": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
