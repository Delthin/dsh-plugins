{
  "name": "@delthin/dsh-tool-wrap",
  "version": "1.3.1",
  "type": "module",
  "description": "Load plugin tools on demand and organize prompts into system, fixed-user, and changing-state sections in DSH PTC sessions.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Delthin/dsh-plugins.git",
    "directory": "packages/tool-wrap"
  },
  "homepage": "https://github.com/Delthin/dsh-plugins/tree/main/packages/tool-wrap#readme",
  "bugs": {
    "url": "https://github.com/Delthin/dsh-plugins/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./origin-bootstrap": "./origin-bootstrap.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "core.js",
    "summaries.js",
    "origins.js",
    "prompt-origins.js",
    "prompt-composition.js",
    "composition-runtime.js",
    "host-support",
    "origin-bootstrap.js",
    "client.js",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check core.js && node --check summaries.js && node --check origins.js && node --check prompt-origins.js && node --check prompt-composition.js && node --check composition-runtime.js && node --check host-support/admission.js && node --check host-support/patches.js && node --check host-support/adapter.mjs && node --check origin-bootstrap.js && node --check client.js && node --check test/fixture.js",
    "test": "node --test test/*.test.js",
    "prepack": "npm run check && npm test"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@deepseek-ai/dsh-agent-instructions": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.1",
    "@deepseek-ai/dsh-fs-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.2-rc.1",
    "@deepseek-ai/dsh-ptc-runtime-node": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-ptc": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5",
    "@deepseek-ai/dsh-scope": ">=0.2.1-rc.5 || >=0.2.2-rc.1",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-ptc": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.5 || >=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
