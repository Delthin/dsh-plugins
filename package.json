{
  "name": "delthin-dsh-plugins-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Independent DSH plugins maintained in one workspace",
  "license": "PolyForm-Noncommercial-1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=11.5.1"
  },
  "scripts": {
    "check": "node scripts/check-workspaces.mjs",
    "check:pack": "node scripts/check-packages.mjs",
    "check:public": "node scripts/check-public.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "js-yaml": "4.3.2",
    "semver": "7.8.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Delthin/dsh-plugins.git"
  }
}
